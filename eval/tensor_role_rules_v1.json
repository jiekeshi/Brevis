{
  "schema": {
    "id": "brevis.tensor-role-rules",
    "version": 1
  },
  "frozen": true,
  "matching": {
    "input": "normalized tensor name",
    "normalization": "Unicode casefold; replace slash and colon with dot; collapse repeated dots; strip leading and trailing dots",
    "selection": "first matching rule independently within each taxonomy axis",
    "pattern_syntax": "Python regular expression searched against the complete normalized name"
  },
  "scope": "Deterministic name-based labels for stratified analysis. These labels are heuristics, not architecture ground truth.",
  "taxonomies": {
    "parameter_kind": {
      "default": "other",
      "rules": [
        {
          "id": "zero_point",
          "value": "zero_point",
          "patterns": [
            "(^|\\.)(zero_?point|zero_?points|qzeros?)(\\.|$)"
          ]
        },
        {
          "id": "running_statistic",
          "value": "running_statistic",
          "patterns": [
            "(^|\\.)(running_mean|running_var|num_batches_tracked)(\\.|$)"
          ]
        },
        {
          "id": "scale",
          "value": "scale",
          "patterns": [
            "(^|\\.)(scale|scales|weight_scale|act_scale|input_scale|output_scale|gamma)(\\.|$)"
          ]
        },
        {
          "id": "bias",
          "value": "bias",
          "patterns": [
            "(^|\\.)(bias|beta)(\\.|$)"
          ]
        },
        {
          "id": "weight",
          "value": "weight",
          "patterns": [
            "(^|\\.)(weight|qweight|kernel)(\\.|$)"
          ]
        }
      ]
    },
    "component_role": {
      "default": "other",
      "rules": [
        {
          "id": "token_embedding",
          "value": "token_embedding",
          "patterns": [
            "(^|\\.)(embed_tokens|word_embeddings?|token_embeddings?|wte)(\\.|$)"
          ]
        },
        {
          "id": "position_embedding",
          "value": "position_embedding",
          "patterns": [
            "(^|\\.)(position_embeddings?|pos_embed|wpe)(\\.|$)"
          ]
        },
        {
          "id": "attention",
          "value": "attention",
          "patterns": [
            "(^|\\.)(self_attn|cross_attn|attention|attn)(\\.|$)",
            "(^|\\.)(q_proj|k_proj|v_proj|o_proj|qkv|query_key_value|c_attn|in_proj)(\\.|$)"
          ]
        },
        {
          "id": "feed_forward",
          "value": "feed_forward",
          "patterns": [
            "(^|\\.)(mlp|ffn|feed_forward|feedforward|gate_proj|up_proj|down_proj|fc1|fc2|wi|wo)(\\.|$)"
          ]
        },
        {
          "id": "normalization",
          "value": "normalization",
          "patterns": [
            "(^|\\.)(layer_?norm|rms_?norm|ln_?[0-9]*|norm)(\\.|$)"
          ]
        },
        {
          "id": "convolution",
          "value": "convolution",
          "patterns": [
            "(^|\\.)(conv[0-9d_]*|convolution)(\\.|$)"
          ]
        },
        {
          "id": "recurrent",
          "value": "recurrent",
          "patterns": [
            "(^|\\.)(lstm|gru|rnn)(\\.|$)"
          ]
        },
        {
          "id": "output_head",
          "value": "output_head",
          "patterns": [
            "(^|\\.)(lm_head|classifier|classification_head|score)(\\.|$)"
          ]
        }
      ]
    },
    "projection_role": {
      "default": "none",
      "rules": [
        {
          "id": "qkv_combined",
          "value": "qkv_combined",
          "patterns": [
            "(^|\\.)(qkv|query_key_value|c_attn|in_proj)(\\.|$)"
          ]
        },
        {
          "id": "query",
          "value": "query",
          "patterns": [
            "(^|\\.)(q_proj|query)(\\.|$)"
          ]
        },
        {
          "id": "key",
          "value": "key",
          "patterns": [
            "(^|\\.)(k_proj|key)(\\.|$)"
          ]
        },
        {
          "id": "value",
          "value": "value",
          "patterns": [
            "(^|\\.)(v_proj|value)(\\.|$)"
          ]
        },
        {
          "id": "gate",
          "value": "gate",
          "patterns": [
            "(^|\\.)(gate_proj|wi_0|w1)(\\.|$)"
          ]
        },
        {
          "id": "up",
          "value": "up",
          "patterns": [
            "(^|\\.)(up_proj|wi_1|fc1|w3)(\\.|$)"
          ]
        },
        {
          "id": "down",
          "value": "down",
          "patterns": [
            "(^|\\.)(down_proj|wo|fc2|w2)(\\.|$)"
          ]
        },
        {
          "id": "output",
          "value": "output",
          "patterns": [
            "(^|\\.)(o_proj|out_proj|dense)(\\.|$)"
          ]
        }
      ]
    },
    "routing_scope": {
      "default": "shared",
      "rules": [
        {
          "id": "router",
          "value": "router",
          "patterns": [
            "(^|\\.)(router|routing)(\\.|$)",
            "(^|\\.)(block_sparse_moe|moe)\\.gate(\\.|$)"
          ]
        },
        {
          "id": "expert",
          "value": "expert",
          "patterns": [
            "(^|\\.)(experts?|expert_[0-9]+)(\\.|$)"
          ]
        }
      ]
    }
  }
}
